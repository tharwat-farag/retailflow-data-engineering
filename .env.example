# ==============================================================================
# RetailFlow Data Engineering Pipeline - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before running Docker or Python warehouse scripts:
#   PowerShell: Copy-Item .env.example .env
# ==============================================================================

# PostgreSQL Warehouse Credentials & Network
POSTGRES_USER=retailflow_admin
POSTGRES_PASSWORD=retailflow_secure_pass
POSTGRES_DB=retailflow_warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Pipeline & Execution Configuration
DATA_DIR=data/raw
LOG_LEVEL=INFO
RANDOM_SEED=42
